STOCKBOT_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://stockbot:stockbot@localhost:5432/stockbot
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REALTIME_REDIS_URL=redis://localhost:6379/2
REALTIME_KEY_PREFIX=stockbot:realtime
REALTIME_TICKET_TTL_SECONDS=60
REALTIME_OUTBOUND_QUEUE_SIZE=256
REALTIME_REPLAY_LIMIT=500
REALTIME_SESSION_TTL_SECONDS=28800
STOCKBOT_LOCAL_ACCESS_KEY=change-this-local-mvp-key
AUTHENTICATION_REQUIRED=true
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_LOGIN_LIMIT=10
SECURITY_UPLOAD_LIMIT=10
SECURITY_COMMAND_LIMIT=60
SECURITY_EXPORT_LIMIT=30
STORAGE_ROOT=./data
CORS_ORIGINS=["http://localhost:5173"]
DEPENDENCY_TIMEOUT_SECONDS=1.0
DATASET_SYNC_VALIDATION_MAX_BYTES=5242880
DATASET_UPLOAD_MAX_BYTES=262144000
